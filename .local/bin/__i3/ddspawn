#!/bin/sh

[ -z "$1" ] && exit

Cmd=$1
Script=dropdown_$1
shift

eval "$(_utils_wmclass)"

if [ "$WM_INSTANCE" = "$Script" ]; then
	i3-msg -q "[instance=\"$Script\"] move scratchpad"
elif xwininfo -tree -root | grep -q "(\"$Script\" "; then
	i3-msg -q "[instance=\"$Script\"] scratchpad show;
		[instance=\"$Script\"] focus, move position center"
else
	i3-msg -q "exec --no-startup-id $TERMINS $Script $@ -e $Cmd"
fi

