#!/bin/sh

IFS='
'

for AUR_Package in $(pacman -Qmmq); do
    for pkg_file in $(pacman -Qlq "$AUR_Package"); do
        if [ -f "$pkg_file" ] && [ -x "$pkg_file" ]; then
            ldd_output=$(ldd "$pkg_file" 2>/dev/null)
            if [ $? -eq 0 ]; then
                for line in $(printf '%s\n' "$ldd_output" | grep -F '=> not found'); do
                    printf '%s\n' "Missing depency for file $pkg_file from package $AUR_Package: $line"
                done
            fi
        fi
    done
done

