{
    "credentials_path": "~/.config/zotify/credentials.json",
    "path_archive": "~/.config/zotify/track_archive",
    "album_library": "~/Music",
    "podcast_library": "~/Music/Podcasts",
    "playlist_library": "~/Music/Playlists",
    "output_album": "{album_artist}/{year} - {album}/{track_number}. {artists} - {title}",
    "output_playlist_track": "{playlist}/{artists} - {title}",
    "output_playlist_episode": "{playlist}/{episode_number} - {title}",
    "output_podcast": "{podcast}/{episode_number} - {title}",
    "download_quality": "auto",
    "artwork_size": "large",
    "audio_format": "vorbis",
    "transcode_bitrate": -1,
    "ffmpeg_path": "",
    "ffmpeg_args": "",
    "save_subtitles": false,
    "language": "en",
    "lyrics_file": false,
    "lyrics_only": false,
    "create_playlist_file": true,
    "save_metadata": true,
    "all_artists": true,
    "replace_existing": false,
    "skip_previous": true,
    "skip_duplicates": true,
    "print_downloads": true,
    "print_progress": true,
    "print_skips": false,
    "print_warnings": true,
    "print_errors": true
}
