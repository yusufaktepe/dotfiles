(defcfg
  process-unmapped-keys yes
  danger-enable-cmd yes
  linux-x11-repeat-delay-rate 300,50
  log-layer-changes no
  concurrent-tap-hold yes ;; testing
  rapid-event-delay 3 ;; https://jtroo.github.io/config.html#rapid-event-delay
  ;; override-release-on-activation yes
  ;; linux-unicode-termination space
  ;; alias-to-trigger-on-load startup
)

;; (include local.kbd)

(deflocalkeys-linux
  *  12
  -  13
  ı  23
  ğ  26
  ü  27
  ş  39
  İ  40 ;; kanata doesn't allow using i in deflocalkeys, as it is a default key name.
  ,  43
  <  86
  ö  51
  ç  52
  .  53
)

(defsrc ;; turkish-iso105
 esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  home end ins del
 grv  1    2    3    4    5    6    7    8    9    0    *    -    bspc                nlk  kp/  kp*  kp-
 tab  q    w    e    r    t    y    u    ı    o    p    ğ    ü                        kp7  kp8  kp9
 caps a    s    d    f    g    h    j    k    l    ş    İ    ,    ret                 kp4  kp5  kp6  kp+
 lsft <    z    x    c    v    b    n    m    ö    ç    .         rsft                kp1  kp2  kp3
 lctl wkup lmet lalt            spc           ralt ssrq rctl      pgup  up  pgdn      kp0       kp.  kprt
                                                                  left down right
)

(deflayer trq
 @esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  home end ins del
 @grv  1    2    3    4    5    6    7    8    9    0    *    -    bspc               nlk  kp/  kp*  kp-
 @tab  @q   w    e    r    t    y    u    ı    o    p    ğ    ü                       @kp7 kp8  kp9
 @cap  @a   s    d    f    g    h    j    k    l    @ş   İ    ,    ret                kp4  kp5  kp6  kp+
 @lsft <    z    x    c    v    b    n    m    ö    ç    .         @rsft              kp1  kp2  kp3
 @lctl @wkup @lmet @lalt         @space        @ralt @ssrq @rctl   pgup  up  pgdn     kp0       kp.  kprt
                                                                   left down right
)

;; (deflayer usq
;;  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  home end ins del
;;  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc                ;; nlk  kp/  kp*  kp-
;;  tab  q    w    e    r    t    y    u    i    o    p    [    ]                        ;; kp7  kp8  kp9
;;  caps a    s    d    f    g    h    j    k    l    ;    '    \    ret                 ;; kp4  kp5  kp6  kp+
;;  lsft <    z    x    c    v    b    n    m    ,    .    /         rsft                ;; kp1  kp2  kp3
;;  lctl wkup lmet lalt            spc           ralt ssrq rctl      pgup  up  pgdn      ;; kp0       kp.  kprt
;;                                                                   left down right
;; )

(defvar
  tap-timeout 200
  hold-timeout 200
  tap-timeout-nonmod 150
)

(defvirtualkeys
  ;; for double-tabbed tap-hold add: (macro 5 (on-press tap-vkey relf24))
  ;; https://github.com/jtroo/kanata/issues/1441#issuecomment-2561718295
  relf24 (release-key f24)

  ;; turn off the Caps LED immediately:
  led0 (cmd-log none error sh -c "$HOME/.local/bin/noled")
)

(deftemplate switch-tap-hold (st-timeout sh-timeout hold-action)
  (switch
    ;; https://github.com/jtroo/kanata/discussions/1455
    ((key-timing 3 less-than $st-timeout)) _ break
    () (multi f24 (tap-hold-release $st-timeout $sh-timeout _ $hold-action)) break
  )
)

(deftemplate tholdp (tap-action hold-action)
  (multi
    f24
    (tap-hold-press $tap-timeout $hold-timeout $tap-action $hold-action)
  )
)

(deftemplate thold (tap-action hold-action)
  (multi
    f24
    (tap-hold $tap-timeout $hold-timeout $tap-action $hold-action)
    (macro 5 (on-press tap-vkey relf24)) ;; BUG: meta + touchpad double-tap doesn't work without relf24
  )
)

(defalias
  ;; _relf24 (macro 5 (on-press tap-vkey relf24))
  _led0 (macro 5 (on-release tap-vkey led0))
  _esc (multi esc @_led0)
  _hyper  (multi lmet lalt lctl @_led0 reverse-release-order)    ;; `reverse-release-order` may not be required
  _Shyper (multi lmet lalt lctl lsft)

  cap  (t! tholdp @_esc @_hyper)     ;; tap:Esc hold:_hyper
  ;; esc  (multi f24 (tap-hold $tap-timeout $hold-timeout esc @_Shyper))   ;; tap:Esc hold:_Shyper | NOTE: bc. tap-hold-press issue
  esc  (t! tholdp esc @_Shyper)
  space (tap-hold-release-timeout 140 500 spc @_Shyper spc)

  ;; tap-hold-press & f24 causes issue with lmet + touchpad double-tap
  lmet (tap-hold-press $tap-timeout $hold-timeout M-spc lmet)             ;; tap:Meta+space
  ssrq (tap-hold-press $tap-timeout $hold-timeout M-f rmet)               ;; tap:Meta+f hold:Meta [[PrtSc]]
  lalt (t! tholdp MediaPlayPause lalt)                                    ;; tap:MediaPlayPause
  ralt (t! tholdp kana ralt)                                              ;; tap:Hiragana_Katakana
  lsft (t! tholdp RA-7 lsft)                                              ;; tap:{
  rsft (t! tholdp RA-0 rsft)                                              ;; tap:}
  lctl (t! tholdp RA-8 lctl)                                              ;; tap:[
  rctl (t! tholdp RA-9 rctl)                                              ;; tap:]
  wkup (t! tholdp C-grv wkup)                                             ;; tap:Ctrl+" hold:wkup
  tab  (t! switch-tap-hold $tap-timeout-nonmod $hold-timeout (layer-while-held laytab)) ;; tap:tab hold:layer>laytab
  grv  (t! switch-tap-hold $tap-timeout-nonmod $hold-timeout lsft)                      ;; tap:" hold:Shift

  ;; NOTE: With tap-hold + letter keys, double-tap-hold to repeat the key

  a (t! switch-tap-hold $tap-timeout-nonmod 500 ralt)
  q (t! switch-tap-hold $tap-timeout-nonmod 500 (layer-while-held sym))
  ş (t! switch-tap-hold $tap-timeout-nonmod 500 (layer-while-held şym))

  ;; startup (cmd-log none error sh -c "notify-send -a system -i keyboard -r 2002 'kanata' 'keyboard remapper is started.'")
  ;; cmenu (arbitrary-code 156)

  kp7 (t! switch-tap-hold $tap-timeout-nonmod 500 (layer-while-held bypass))
)

(defchordsv2
  (f1 f2) M-del 200 first-release ()
  ;; (w e) esc 50 all-released ()
  ;; (i o) bspc 50 all-released ()
  ;; (x c) tab 50 all-released ()
  ;; (, .) ret 50 all-released ()
  ;; (j k) (switch
  ;;         ((input-history real k 1)) esc break ()
  ;;         (macro k j) break
  ;;       ) 150 all-released ()
)

(deflayermap (bypass)
  _ use-defsrc
)

(deflayermap (sym) ;; q
  grv  RA-\ ;; " = `
  3    RA-3 ;; 3 = #
  4    RA-4 ;; 4 = $
  7    RA-7 ;; 7 = {
  8    RA-8 ;; 8 = [
  9    RA-9 ;; 9 = ]
  0    RA-0 ;; 7 = }
  *    RA-* ;; * = \
  u    S-8  ;; u = (
  ı    S-9  ;; ı = )
  o    RA-7 ;; p = {
  p    RA-0 ;; p = }
  ğ    RA-8 ;; ğ = [
  ü    RA-9 ;; ü = ]
  ş    RA-4 ;; ş = $
  İ    S-2  ;; i = '
  bksl RA-* ;; , = \
  /    S-7  ;; . = /
  ö    ,
  ç    .
  lsft S-8 ;; lsft = (
  rsft S-9 ;; rsft = )
  eql  (unicode "—")
  ;; g    @gmail
  ;; y    @ymail
  _    use-defsrc ;; map all unmapped keys in this layer that are defined in defsrc.
)
(deflayermap (şym) ;; ş
  grv  RA-\ ;; " = `
  q    RA-q ;; q = @
  ğ    RA-7 ;; ğ = {
  ü    RA-0 ;; ü = }
  İ    S-8  ;; i = (
  bksl S-9  ;; , = )
  ö    <    ;; ö = <
  ç    S-<  ;; ç = >
  <    RA-< ;; < = |
  lsft S-8 ;; lsft = (
  rsft S-9 ;; rsft = )
)

(deflayermap (laytab)
  esc M-del
  caps @_Shyper

  g C-home
  f C-end

  w (mwheel-up 50 50)
  s (mwheel-down 50 50)
  e (mwheel-up 50 120)
  d (mwheel-down 50 120)

  h home
  l end
  j (mwheel-down 50 240)
  k (mwheel-up 50 240)
)

